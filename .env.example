# Career app — environment. Copy to .env and fill in.
# .env is sourced by scripts (set -a; . ./.env; set +a) — keep the `export`
# prefixes and ${VAR} interpolation; dotenv does NOT expand them.

# --- Supabase (CLI + scripts) ---
export SUPABASE_PROJECT_REF=mvmteuwwvahkicsybxsl
export SUPABASE_DB_PASSWORD=
export SUPABASE_ACCESS_TOKEN=

# --- Cloudflare Workers AI (edge-function secrets; also used by the Node classifier) ---
export CLOUDFLARE_ACCOUNT_ID=
export CLOUDFLARE_API_TOKEN=

# --- Postgres (Supabase pooler) ---
export PGHOST=aws-1-eu-west-1.pooler.supabase.com
export PGPORT=5432
export PGUSER="postgres.${SUPABASE_PROJECT_REF}"
export PGPASSWORD="${SUPABASE_DB_PASSWORD}"
export PGDATABASE=postgres
export PGSSLMODE=require
export DATABASE_URL="postgresql://postgres.${SUPABASE_PROJECT_REF}:${SUPABASE_DB_PASSWORD}@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Optional ---
# export EMAIL_CLASSIFIER_MAX_CALLS_PER_SCAN=12   # 0 disables model jobs (rollback lever)
