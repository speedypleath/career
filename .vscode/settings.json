{
  // Use the repo's TypeScript, not the one bundled with VS Code — the build is
  // the type-check gate, so the editor should agree with it.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // The Jest extension (orta.vscode-jest). Jest needs --experimental-vm-modules
  // because package.json is "type": "module"; going through `npm test` keeps
  // that flag defined in exactly one place.
  "jest.jestCommandLine": "npm test --",
  "jest.runMode": "on-demand",

  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
    "editor.formatOnSave": true
  },

  // schema.prisma is generated by `npm run db:pull`. Editing it by hand is
  // almost always a mistake; the trim comments at the top say why.
  "files.watcherExclude": {
    "**/.next/**": true
  },
  "search.exclude": {
    ".next": true,
    "node_modules": true,
    "prisma/schema.prisma": false
  },
  "sqltools.connections": [
    {
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "driver": "PostgreSQL",
      "name": "career",
      "database": "career",
      "username": "youruser"
    }
  ]
}
