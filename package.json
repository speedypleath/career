{
  "name": "career",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8098",
    "build": "next build",
    "start": "next start -p 8098",
    "lint": "eslint",
    "lint:openapi": "redocly lint",
    "docs:openapi": "redocly preview-docs docs/openapi.yaml",
    "test:classifier": "node --test --experimental-strip-types tests/email-classifier.test.ts",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "db:pull": "prisma db pull && prisma generate",
    "db:pull:targets": "node --experimental-strip-types src/cli/pull-hosted-data.ts",
    "classifier:evaluate": "node --experimental-strip-types src/cli/eval-classifier.ts",
    "classifier:debug": "node --experimental-strip-types src/cli/debug-classify.ts",
    "classifier:reclassify": "node --experimental-strip-types src/cli/reclassify.ts",
    "classifier:requeue": "node --experimental-strip-types src/cli/requeue-failed-emails.ts",
    "email:backfill-html": "node --experimental-strip-types src/cli/backfill-html-bodies.ts",
    "maintenance:clean": "node --experimental-strip-types src/cli/clean-and-fix.ts",
    "postinstall": "prisma generate",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --watch",
    "test:node": "node --test --experimental-strip-types \"tests/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swagger-ui-dist": "^5.32.15"
  },
  "devDependencies": {
    "@redocly/cli": "^2.51.2",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-dist": "^3.30.6",
    "audit-ci": "^7.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.2",
    "jest": "^30.5.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
