// Config for `npm run lint` counterpart in CI (.github/workflows/deploy.yml
// `security` job): fail the pipeline on any HIGH/CRITICAL dependency advisory
// that is not listed below.
{
  "high": true,
  "critical": true,
  "report-type": "summary",
  // Both live in the Prisma 7 CLI dependency tree (`@prisma/client` ->
  // `prisma` -> `mysql2` / `@prisma/config` -> `deepmerge-ts`). This app talks
  // only to Postgres via `pg` and the Prisma query engine — the MySQL driver
  // and the config-file deep-merge are never loaded at runtime. Remove an entry
  // once an upstream Prisma patch bumps the dependency.
  "allowlist": [
    "GHSA-ggr8-5vv4-36mx", // deepmerge-ts <8 stack exhaustion (via @prisma/config)
    "GHSA-3f6p-5ww8-9rcr"  // mysql2 auth-plugin downgrade (via prisma CLI)
  ]
}
